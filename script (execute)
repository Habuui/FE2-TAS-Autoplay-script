local refreshSavedList

-- ========== SAVE / DELETE LOCAL TAS ==========
local function saveTAS(name)
    if #state.currentTAS < 10 then
        showNotif("❌ Not enough frames to save!", false)
        return false
    end
    if name == nil or name == "" then name = "TAS_" .. os.time() end

    local finalName = name
    local counter   = 1
    while savedTAS[finalName] do
        finalName = name .. "_" .. counter
        counter   = counter + 1
    end

    savedTAS[finalName]       = state.currentTAS
    getgenv().FE2_TAS_SAVES   = savedTAS
    showNotif("💾 Saved locally: " .. finalName, true)
    refreshSavedList()
    return true
end

local function deleteTAS(name)
    if savedTAS[name] then
        savedTAS[name]          = nil
        getgenv().FE2_TAS_SAVES = savedTAS
        showNotif("🗑️ Deleted: " .. name, true)
        refreshSavedList()
    end
end

-- ========== RECORDING ==========
local recordingStartTime = 0
local inputConnections   = nil

local function startRecording()
    if state.isRecording then showNotif("❌ Já gravando!", false); return end
    if state.isPlaying then
        state.isPlaying = false
        if state.playbackConnection then
            state.playbackConnection:Disconnect()
            state.playbackConnection = nil
        end
    end

    state.currentTAS     = {}
    state.currentMapName = ""
    state.isRecording    = true
    recordingStartTime   = tick()

    for k in pairs(state.lastInputStates) do state.lastInputStates[k] = false end
    showNotif("🔴 RECORDING STARTED! Press G to stop", true)

    local kfConn = rs.Stepped:Connect(function()
        if not state.isRecording then return end
        local char = player.Character
        if char and char:FindFirstChild("HumanoidRootPart") and char:FindFirstChild("Humanoid") then
            local hrp      = char.HumanoidRootPart
            local humanoid = char.Humanoid
            table.insert(state.currentTAS, {
                type          = "keyframe",
                time          = tick() - recordingStartTime,
                cframe        = hrp.CFrame,
                velocity      = hrp.AssemblyLinearVelocity,
                moveDirection = humanoid.MoveDirection,
                humanoidState = humanoid:GetState(),
                slideActive   = uis:IsKeyDown(Enum.KeyCode.E),
                inputs = {
                    W     = uis:IsKeyDown(Enum.KeyCode.W),
                    A     = uis:IsKeyDown(Enum.KeyCode.A),
                    S     = uis:IsKeyDown(Enum.KeyCode.S),
                    D     = uis:IsKeyDown(Enum.KeyCode.D),
                    Space = uis:IsKeyDown(Enum.KeyCode.Space),
                    E     = uis:IsKeyDown(Enum.KeyCode.E)
                }
            })
        end
    end)

    local function onInputBegan(input, gpe)
        if not state.isRecording or gpe then return end
        for name, code in pairs(KEYS) do
            if input.KeyCode == code and not state.lastInputStates[name] then
                state.lastInputStates[name] = true
                table.insert(state.currentTAS, {
                    type  = "input",
                    time  = tick() - recordingStartTime,
                    key   = name,
                    state = true,
                })
            end
        end
    end

    local function onInputEnded(input, gpe)
        if not state.isRecording or gpe then return end
        for name, code in pairs(KEYS) do
            if input.KeyCode == code and state.lastInputStates[name] then
                state.lastInputStates[name] = false
                table.insert(state.currentTAS, {
                    type  = "input",
                    time  = tick() - recordingStartTime,
                    key   = name,
                    state = false,
                })
            end
        end
    end

    local ibConn = uis.InputBegan:Connect(onInputBegan)
    local ieConn = uis.InputEnded:Connect(onInputEnded)
    inputConnections          = {kfConn, ibConn, ieConn}
    state.recordingConnection = inputConnections
end

local function stopRecording()
    if not state.isRecording then return end
    state.isRecording = false
    if state.recordingConnection then
        for _, conn in ipairs(state.recordingConnection) do
            if conn then pcall(function() conn:Disconnect() end) end
        end
        state.recordingConnection = nil
    end
    table.sort(state.currentTAS, function(a, b) return a.time < b.time end)
    if #state.currentTAS > 10 then
        showNotif("⏹️ Recording done! (" .. #state.currentTAS .. " events)", true)
    else
        showNotif("⚠️ Too few events recorded!", false)
        state.currentTAS = {}
    end
end

-- ========== RESTORE CONTROL ==========
local function restoreCharacterControl()
    if state.isPlaying then
        state.isPlaying = false
        if state.playbackConnection then
            pcall(function() state.playbackConnection:Disconnect() end)
            state.playbackConnection = nil
        end
    end
    for _, code in pairs(KEYS) do
        pcall(function() vim:SendKeyEvent(false, code, false, game) end)
    end
    local char = player.Character
    if char then
        local humanoid = char:FindFirstChild("Humanoid")
        if humanoid then
            humanoid.WalkSpeed  = DEFAULT_WALK_SPEED
            humanoid.JumpPower  = DEFAULT_JUMP_POWER
            humanoid.AutoRotate = true
        end
        if state.originalRootC0 then
            local rj = char:FindFirstChild("RootJoint", true)
            if rj then pcall(function() rj.C0 = state.originalRootC0 end) end
            state.originalRootC0 = nil
        end
    end
end

local function interruptPlayback()
    if not state.isPlaying then return end
    state.isPlaying = false
    if state.playbackConnection then
        pcall(function() state.playbackConnection:Disconnect() end)
        state.playbackConnection = nil
    end
    restoreCharacterControl()
    showNotif("⏹️ Playback cancelled!", false, 2)
end

-- ========== PLAYBACK ENGINE (pure frame-by-frame, same as TAS creator) ==========
-- MAIN FIX: replaced the real-time elapsed-based engine with pure frame-by-frame.
-- Reason: the real-time engine processed multiple frames per step under lag,
-- causing visible teleports and replaying 'ghost' frames the player had
-- discarded during TAS creator editing. Frame-by-frame is deterministic:
-- always 1 frame per physics tick, identical to TAS creator internal playback.
local function startPlayback()
    local now = tick()
    if now - state.lastPlaybackCall < 0.5 then return end
    state.lastPlaybackCall = now

    if #state.currentTAS == 0 then showNotif("❌ No TAS loaded!", false); return end
    if state.isPlaying then interruptPlayback(); task.wait(0.05) end

    local char = player.Character
    if not char then return end
    local hrp      = char:FindFirstChild("HumanoidRootPart")
    local humanoid = char:FindFirstChild("Humanoid")
    if not hrp or not humanoid then return end

    -- Filter only keyframes to position character at the start
    local firstKF = nil
    for _, ev in ipairs(state.currentTAS) do
        if ev.type == "keyframe" then firstKF = ev; break end
    end
    if firstKF and firstKF.cframe then
        hrp.CFrame = firstKF.cframe
        hrp.AssemblyLinearVelocity = Vector3.zero
    end

    -- Save original RootJoint for wallhop
    local rootJoint = char:FindFirstChild("RootJoint", true)
    if rootJoint then state.originalRootC0 = rootJoint.C0 else state.originalRootC0 = nil end

    task.wait(0.1)

    char = player.Character
    if not char or not char:FindFirstChild("HumanoidRootPart") or not char:FindFirstChild("Humanoid") then
        restoreCharacterControl(); return
    end

    state.isPlaying = true
    showNotif("▶️ PLAYING...", true)

    -- Separate keyframes from inputs for the frame-by-frame engine
    -- and apply inputs embedded in each keyframe (inputs={} field)
    local keyframes   = {}
    local inputEvents = {}
    for _, ev in ipairs(state.currentTAS) do
        if ev.type == "keyframe" then
            table.insert(keyframes, ev)
        elseif ev.type == "input" then
            table.insert(inputEvents, ev)
        end
    end

    local totalKeyframes = #keyframes
    local playbackIndex  = 1
    local inputIndex     = 1
    local totalInputs    = #inputEvents
    local lastApplied    = {}
    for k in pairs(KEYS) do lastApplied[k] = false end
    local lastSlideState  = false
    local wallhopProcessed = false
    -- Time anchor: same system as TAS creator.
    -- elapsed = time elapsed + first keyframe time.
    -- Guarantees playback speed faithful to recording, no acceleration or slowdown.
    local startTick = tick()
    local firstFrameTime = keyframes[1] and keyframes[1].time or 0

    if state.playbackConnection then state.playbackConnection:Disconnect() end
    state.playbackConnection = rs.Stepped:Connect(function()
        if not state.isPlaying then return end

        local cc = player.Character
        if not cc or not cc:FindFirstChild("HumanoidRootPart") or not cc:FindFirstChild("Humanoid") then
            restoreCharacterControl()
            showNotif("❌ Character interrupted.", false)
            return
        end

        if playbackIndex > totalKeyframes then
            -- Release all keys on finish
            for key, code in pairs(KEYS) do
                if lastApplied[key] then
                    pcall(function() vim:SendKeyEvent(false, code, false, game) end)
                    lastApplied[key] = false
                end
            end
            if lastSlideState then
                pcall(function() vim:SendKeyEvent(false, Enum.KeyCode.E, false, game) end)
            end
            state.isPlaying = false
            if state.playbackConnection then
                state.playbackConnection:Disconnect()
                state.playbackConnection = nil
            end
            restoreCharacterControl()
            showNotif("✅ PLAYBACK FINISHED!", true, 2.5)
            return
        end

        local ch  = cc.HumanoidRootPart
        local hum = cc.Humanoid
        local kf  = keyframes[playbackIndex]

        -- Só processa o frame se o tempo real já chegou nele
        local elapsed = (tick() - startTick) + firstFrameTime
        if kf.time > elapsed then return end

        -- Apply keyframe position and velocity
        -- FIX: uses only AssemblyLinearVelocity (Velocity is deprecated and caused conflicts)
        if kf.cframe then ch.CFrame = kf.cframe end
        if kf.velocity then ch.AssemblyLinearVelocity = kf.velocity end

        -- Apply Humanoid state
        if kf.humanoidState then
            local stateVal = type(kf.humanoidState) == "number" and kf.humanoidState or kf.humanoidState.Value
            pcall(function() hum:ChangeState(stateVal) end)
        end

        -- Slide (E key)
        if kf.slideActive ~= nil and kf.slideActive ~= lastSlideState then
            lastSlideState = kf.slideActive
            pcall(function() vim:SendKeyEvent(kf.slideActive, Enum.KeyCode.E, false, game) end)
        end

        -- Wallhop: no task.spawn to avoid physics race condition
        if state.wallhopEnabled and kf.wallhopFlick and not wallhopProcessed then
            wallhopProcessed = true
            pcall(function() hum:ChangeState(Enum.HumanoidStateType.Jumping) end)
            ch.AssemblyLinearVelocity = Vector3.new(ch.AssemblyLinearVelocity.X, 40, ch.AssemblyLinearVelocity.Z)
            local rj = cc:FindFirstChild("RootJoint", true)
            if rj and state.originalRootC0 then
                local orig = state.originalRootC0
                pcall(function() rj.C0 = orig * CFrame.Angles(0, 0, math.rad(65)) end)
                -- The visual flick is undone automatically on the next frame
                -- since the next applyFrame will restore the correct position
            end
        elseif not kf.wallhopFlick then
            wallhopProcessed = false
            -- Restore RootJoint if it was flicked on the previous frame
            local rj = cc:FindFirstChild("RootJoint", true)
            if rj and state.originalRootC0 then
                pcall(function() rj.C0 = state.originalRootC0 end)
            end
        end

        -- Inputs embedded in keyframe (inputs={W,A,S,D,Space,E} field)
        if kf.inputs then
            for keyName, pressed in pairs(kf.inputs) do
                local keyCode = KEYS[keyName]
                if keyCode and lastApplied[keyName] ~= pressed then
                    lastApplied[keyName] = pressed
                    pcall(function() vim:SendKeyEvent(pressed, keyCode, false, game) end)
                end
            end
        end

        -- Separate inputs aligned by real elapsed time
        while inputIndex <= totalInputs and inputEvents[inputIndex].time <= elapsed do
            local ev = inputEvents[inputIndex]
            local keyCode = KEYS[ev.key]
            if keyCode and lastApplied[ev.key] ~= ev.state then
                lastApplied[ev.key] = ev.state
                pcall(function() vim:SendKeyEvent(ev.state, keyCode, false, game) end)
            end
            inputIndex = inputIndex + 1
        end

        playbackIndex = playbackIndex + 1
    end)
end

-- ========== RESET ==========
local function forceReset()
    if state.isRecording then stopRecording() end
    if state.isPlaying    then interruptPlayback() end
    state.currentTAS     = {}
    state.currentMapName = ""
    showNotif("🔄 State cleared!", true, 1.5)
end

-- ========== WALLCLIP ==========
local function fakeWallclip()
    if not state.wallclipEnabled then return end
    local char = player.Character
    if not char then return end
    local hrp = char:FindFirstChild("HumanoidRootPart")
    if not hrp then return end

    local params = RaycastParams.new()
    params.FilterType = Enum.RaycastFilterType.Exclude
    params.FilterDescendantsInstances = {char}

    local ray = workspace:Raycast(hrp.Position, hrp.CFrame.LookVector * 2.5, params)
    if ray and ray.Distance < 2.2 then
        hrp.CFrame = CFrame.new(hrp.Position + hrp.CFrame.LookVector * 5)
        showNotif("🌀 WALLCLIP!", true, 0.8)
    end
end

-- ========== MANUAL WALLHOP ==========
local function fakeWallhop()
    if not state.wallhopEnabled then return end
    local char = player.Character
    if not char then return end
    local hrp      = char:FindFirstChild("HumanoidRootPart")
    local humanoid = char:FindFirstChild("Humanoid")
    if not hrp or not humanoid then return end

    local params = RaycastParams.new()
    params.FilterType = Enum.RaycastFilterType.Exclude
    params.FilterDescendantsInstances = {char}

    local ray = workspace:Raycast(hrp.Position, hrp.CFrame.LookVector * 2, params)
    if ray and ray.Distance < 1.8 then
        humanoid:ChangeState(Enum.HumanoidStateType.Jumping)
        task.wait(0.05)
        hrp.AssemblyLinearVelocity = Vector3.new(hrp.AssemblyLinearVelocity.X, 40, hrp.AssemblyLinearVelocity.Z)

        if state.isRecording and #state.currentTAS > 0 then
            for i = #state.currentTAS, 1, -1 do
                if state.currentTAS[i].type == "keyframe" then
                    state.currentTAS[i].wallhopFlick = true
                    break
                end
            end
        end

